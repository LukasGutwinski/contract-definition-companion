{
  "name": "contract-definition-companion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "certs": "office-addin-dev-certs install",
    "dev": "vite --host 0.0.0.0",
    "dev:http": "VITE_HTTPS=false vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/office-js-preview": "^1.0.7",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.0.2",
    "office-addin-dev-certs": "^2.0.9",
    "typescript": "^5.3.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  }
}
